<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Optimize>true</Optimize>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="10.0.0" />
    <PackageReference Include="OpenTelemetry" Version="1.20.1" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../process-context-perf/Program.cs" Link="LinkProgram.cs" />
    <Compile Include="LinkSamplingBenchmarks.cs" />
  </ItemGroup>
</Project>
